# RAG系统环境变量配置

# Elasticsearch配置
ELASTICSEARCH_VERSION=8.8.0
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=medical_documents

# Milvus配置
MILVUS_VERSION=v2.3.0
MILVUS_URL=http://milvus:19530
MILVUS_COLLECTION=medical_vectors
VECTOR_DIMENSION=768

# PostgreSQL配置
POSTGRES_VERSION=15
POSTGRES_DB=rag_system
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_URL=postgresql://admin:password@postgres:5432/rag_system

# MinIO配置
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_URL=http://minio:9000

# 系统配置
COMPOSE_PROJECT_NAME=rag-system
NETWORK_NAME=rag-network